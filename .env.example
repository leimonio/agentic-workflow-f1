# Copy to .env (git-ignored). Never commit real tokens.
# monday personal API token (needed from step 3): monday.com > profile > Developers > My access tokens
MONDAY_API_TOKEN=
# Chromatic project token: chromatic.com > your project > Manage > Configure
CHROMATIC_PROJECT_TOKEN=
# Where the tracker lives: local (files in .agent/items) or monday (needs MONDAY_API_TOKEN and npm run board:setup)
AGENT_TRACKER=local
